  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "author": "michaelliv",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.8.0"
  }
